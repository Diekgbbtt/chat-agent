# Copy to .env and fill the required values.
# Keep .env out of version control.

# --- Required for the Speakeasy bot ---
BOT_USERNAME=
BOT_PASSWORD=

# --- Graph input ---
# Usually required unless dataset/graph.nt or the Nuvolos mount exists.
GRAPH_PATH=/absolute/path/to/graph.nt
# Optional store cache. Default: kg_store/ next to agent/.
# KG_STORE_PATH=kg_store

# --- Runtime ---
# legacy | llm
AGENT_MODE=llm
SPEAKEASY_HOST=https://speakeasy.ifi.uzh.ch
LOG_DIR=logs
AGENT_WORKERS=8
REPLY_TIMEOUT_S=25
HEARTBEAT_S=300
QUERY_TIMEOUT_S=20
MAX_FETCH_ROWS=10000

# --- Local OpenAI-compatible model endpoint ---
# Required for llm. The defaults are shown.
LOCAL_MODEL=Qwen/Qwen3-4B-Instruct-2507
LOCAL_BASE_URL=http://127.0.0.1:8000/v1
# Optional per-role endpoints and models. They default to LOCAL_*.
# GUARD_MODEL=Qwen/Qwen3-4B-Instruct-2507
# GUARD_BASE_URL=http://127.0.0.1:8000/v1
# GUARD_API_KEY=local
# QA_MODEL=Qwen/Qwen3-4B-Instruct-2507
# QA_BASE_URL=http://127.0.0.1:8000/v1
# QA_API_KEY=local
# Optional guard schema override.
# GUARD_SCHEMA_PATH=agent/data/guardrails.json

# --- Legacy in-process model only ---
# Empty by default. To enable, install requirements-legacy.txt and set a model id.
# LLM_MODEL=Qwen/Qwen3-4B-Instruct-2507
# 4-bit loading; requires bitsandbytes from requirements-legacy.txt. 0 or 1.
# LLM_4BIT=0

# --- Limits and timeouts ---
MODEL_TIMEOUT_S=30
AGENT_DEADLINE_S=20
MAX_AGENT_STEPS=6
MAX_TOOL_ROWS=50
MAX_OBSERVATION_CHARS=1200
MAX_STEP_TOKENS=300
MAX_PROMPT_TOKENS=2200
MAX_ANSWER_CHARS=400
MAX_REFUSAL_CHARS=300
MAX_BOUNDARY_CHARS=160
MAX_CLARIFICATION_CHARS=300
MAX_CAPABILITY_CHARS=300
MAX_GENERAL_CHARS=400

# --- Observability ---
# INFO writes one full trace per answer. DEBUG also writes every trace step.
AGENT_LOG_LEVEL=DEBUG
# Include full LLM messages, tools, content, reasoning, and tool calls. 0 or 1.
AGENT_LOG_PAYLOADS=1
# Optional JSONL destination. Default: LOG_DIR/agent.jsonl.
# AGENT_LOG_FILE=logs/agent.jsonl

# --- Optional switches ---
# Start the local vLLM server with the bot. 0 or 1.
AUTOSTART_MODELS=0
# Keep conversation history. 0 or 1.
HISTORY_ENABLED=0
# Prefix replies with canonical labels. 0 or 1.
SHOW_GUARDRAIL_LABELS=0
